# Copie este arquivo para ".env" e preencha. O ".env" NÃO vai para o GitHub.

# ---- Banco de dados MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=estacionamentoSenac

# ---- Firebase ----
# Arquivo da conta de serviço (Console Firebase > Configurações > Contas de serviço > Gerar chave)
FIREBASE_CREDENTIALS=projectparkingtoken.json
# Console Firebase > Configurações do projeto > Geral > Chave de API da Web
FIREBASE_WEB_API_KEY=

# ---- Servidor ----
PORT=3000
FRONTEND_URL=http://127.0.0.1:5501
CORS_ORIGINS=http://127.0.0.1:5501,http://localhost:5501

# ---- Recuperação de senha ----
# Gere um valor aleatório: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
RESET_SECRET=

# ---- E-mail (SMTP). Vazio = o e-mail aparece só no terminal ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = "senha de app" do Google
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
